  <script>
    (function setRoundFavicon() {
      const logoSrc = '/static/logos/bitjr-logo.png';
      const size = 128;
      const canvas = document.createElement('canvas');
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const img = new Image();
      img.onload = () => {
        ctx.clearRect(0, 0, size, size);
        ctx.beginPath();
        ctx.arc(size / 2, size / 2, size / 2 - 6, 0, Math.PI * 2);
        ctx.fillStyle = '#f7f7f7';
        ctx.fill();
        ctx.lineWidth = 0;

        ctx.save();
        ctx.beginPath();
        ctx.arc(size / 2, size / 2, size / 2 - 12, 0, Math.PI * 2);
        ctx.clip();
        const drawSize = size - 24;
        const x = (size - drawSize) / 2;
        const y = (size - drawSize) / 2;
        ctx.drawImage(img, x, y, drawSize, drawSize);
        ctx.restore();

        const dataUrl = canvas.toDataURL('image/png');
        document.querySelectorAll("link[rel~='icon']").forEach((link) => {
          link.href = dataUrl;
          link.type = 'image/png';
        });
      };
      img.src = logoSrc;
    })();
  </script>
