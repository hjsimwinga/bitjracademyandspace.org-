<h1 class="team-title">Our Team</h1>
<div class="team-grid">
  <% if (team && team.length) { %>
    <% team.forEach(member => { %>
      <article class="team-card">
        <img src="<%= member.photo || '/static/images/avatar.png' %>" alt="<%= member.name %>">
        <h3><%= member.name %></h3>
        <p class="muted"><%= member.role %></p>
        <% if (member.twitter) { %>
          <% const handle = member.twitter.replace(/^https?:\/\/(www\.)?(x|twitter)\.com\//, '@'); %>
          <p><a href="<%= member.twitter %>" target="_blank" rel="noopener"><%= handle %></a></p>
        <% } %>
        <p><%= member.bio %></p>
      </article>
    <% }) %>
  <% } else { %>
    <p>Team coming soon!</p>
  <% } %>
  </div>


